                "type": "object"
              },
              "buildFlags": {
                "type": [
                  "string",
                  "array"
                ]
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false
              },
              "processId": {
                "type": "number"
              },
              "port": {
                "type": "number"
              },
              "host": {
                "type": "string",
                "default": "127.0.0.1"
              },
              "substitutePath": {
                "type": "array"
              },
              "dlvFlags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "showGlobalVariables": {
                "type": "boolean"
              },
              "showRegisters": {
                "type": "boolean"
              },
              "outputMode": {
                "enum": [
                  "remote",
                  "local"
                ],
                "default": "remote",
                "description": "Route program output to the Debug Console or Delve output."
              },
              "stdinFrom": {
                "type": "string"
              },
              "stdoutTo": {
                "type": "string"
              },
              "stderrTo": {
                "type": "string"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "gon",
            "name": "Launch package",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Gon: Debug tests",
            "body": {
              "type": "gon",
              "name": "Debug tests",
              "request": "launch",
              "mode": "test",
              "program": "${workspaceFolder}"
            }
          }
        ]
      },
