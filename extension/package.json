{
  "name": "gon",
  "displayName": "Gon",
  "icon": "media/gon_logo.png",
  "version": "0.1.0",
  "publisher": "gon-lang",
  "description": "Gon language support, with automatic tool discovery and a Run File button.",
  "author": {
    "name": "Gon contributors"
  },
  "license": "MIT",
  "private": true,
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/gonMain.js",
  "activationEvents": [
    "onLanguage:go",
    "onLanguage:gon",
    "onDebugResolve:gon",
    "onDebugResolve:go",
    "workspaceContains:**/*_test.go"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Gon runs a local language server and compiler."
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run typecheck && esbuild src/gon/extension.ts --bundle --outfile=dist/gonMain.js --external:vscode --format=cjs --platform=node",
    "typecheck": "tsc -p tsconfig.gon.json --noEmit",
    "test:syntax": "node gon-tests/syntax.cjs",
    "test": "npm run compile && tsc -p tsconfig.gon.json && node out/gon-tests/run.js",
    "package": "vsce package --no-dependencies --allow-missing-repository -o ../gon-0.1.0.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.0"
  },
  "devDependencies": {
    "@types/node": "16.18.126",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "typescript": "5.9.3"
  },
  "contributes": {
    "languages": [
      {
        "id": "gon",
        "aliases": [
          "Gon"
        ],
        "configuration": "./languages/gon.language-configuration.json",
        "icon": {
          "light": "./media/go-logo-blue.png",
          "dark": "./media/go-logo-blue.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "gon",
        "scopeName": "source.gon",
        "path": "./syntaxes/gon.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "gon",
        "path": "./snippets/go.json"
      },
      {
        "language": "gon",
        "path": "./snippets/gon.json"
      }
    ],
    "commands": [
      {
        "command": "gon.restartLanguageServer",
        "title": "Gon: Restart Language Server"
      },
      {
        "command": "gon.runFile",
        "title": "Run Gon File",
        "category": "Gon",
        "icon": "$(play)",
        "enablement": "isWorkspaceTrusted && resourceScheme == file && resourceExtname == .go"
      },
      {
        "command": "gon.checkProject",
        "title": "Gon: Check Project (saved files)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gon.showToolingCapabilities",
        "title": "Gon: Show Tooling Capabilities"
      }
    ],
    "problemMatchers": [
      {
        "name": "gon-check",
        "owner": "gon",
        "source": "gon check",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (error|warning|info): (.*) \\(([^()]*)\\)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5,
          "code": 6
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "gon.runFile",
          "when": "resourceExtname == .go && resourceScheme == file && !(resourceFilename =~ /_test\\.go$/)",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Gon",
      "properties": {
        "gon.compilerPath": {
          "type": "string",
          "default": "gon",
          "scope": "resource",
          "description": "Optional Gon executable override. Automatically searches PATH and ~/.local/bin. Supports ~ and ${workspaceFolder}.",
          "restricted": true
        },
        "gon.languageServerPath": {
          "type": "string",
          "default": "gonpls",
          "scope": "resource",
          "description": "Optional Gon language server override. By default uses the server from the selected Gon installation. Supports ~ and ${workspaceFolder}.",
          "restricted": true
        },
        "gon.serverSettings": {
          "type": "object",
          "default": {
            "semanticTokens": true
          },
          "scope": "resource",
          "description": "Settings passed to gonpls, using gopls option names."
        },
        "gon.run.mode": {
          "type": "string",
          "enum": [
            "file",
            "package"
          ],
          "default": "file",
          "scope": "resource",
          "description": "Run only the active file or its containing package."
        },
        "gon.run.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Arguments passed to the running program."
        },
        "gon.debuggerPath": {
          "type": "string",
          "default": "dlv",
          "scope": "resource",
          "description": "Delve DAP executable. Uses the selected compiler for each debug session.",
          "restricted": true
        },
        "gon.test.packagePatterns": {
          "type": "array",
          "default": [
            "./..."
          ],
          "scope": "resource",
          "description": "Packages discovered by the test explorer.",
          "restricted": true,
          "items": {
            "type": "string"
          }
        },
        "gon.test.buildFlags": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "description": "Build flags such as -tags=integration, applied to discovery, run, and debug.",
          "restricted": true,
          "items": {
            "type": "string"
          }
        },
        "gon.test.args": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "description": "Extra arguments passed to go/gon test.",
          "restricted": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "configurationDefaults": {
      "[gon]": {
        "editor.defaultFormatter": "gon-lang.gon",
        "editor.insertSpaces": false,
        "editor.tabSize": 4
      }
    },
    "debuggers": [
      {
        "type": "gon",
        "label": "Gon",
        "languages": [
          "gon",
          "go"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "default": "${workspaceFolder}",
                "description": "Package directory, Go source file, or executable (mode exec)."
              },
              "mode": {
                "enum": [
                  "auto",
                  "debug",
                  "test",
                  "exec",
                  "local",
                  "remote"
                ],
                "default": "debug"
              },
              "cwd": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "env": {
                "type": "object"
              },
              "buildFlags": {
                "type": [
                  "string",
                  "array"
                ]
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false
              },
              "processId": {
                "type": "number"
              },
              "port": {
                "type": "number"
              },
              "host": {
                "type": "string",
                "default": "127.0.0.1"
              },
              "substitutePath": {
                "type": "array"
              },
              "dlvFlags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "showGlobalVariables": {
                "type": "boolean"
              },
              "showRegisters": {
                "type": "boolean"
              },
              "outputMode": {
                "enum": [
                  "remote",
                  "local"
                ],
                "default": "remote",
                "description": "Route program output to the Debug Console or Delve output."
              },
              "stdinFrom": {
                "type": "string"
              },
              "stdoutTo": {
                "type": "string"
              },
              "stderrTo": {
                "type": "string"
              }
            }
          },
          "attach": {
            "properties": {
              "program": {
                "type": "string",
                "default": "${workspaceFolder}",
                "description": "Package directory, Go source file, or executable (mode exec)."
              },
